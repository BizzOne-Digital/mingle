# Copy to .env (or .env.local) and fill in. Never commit real values.

# Database (MongoDB Atlas connection string)
MONGODB_URI=

# Public site URL, no trailing slash (used for canonical URLs, sitemap and Stripe return links)
NEXT_PUBLIC_SITE_URL=https://the-mingle.com

# Admin login (single admin account). Secret must be at least 32 random characters,
# e.g. generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Inquiry email notifications (optional — inquiries are always saved to MongoDB even if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_NOTIFICATION_EMAIL=info@themingle.com

# Deposits via Stripe hosted Checkout. The webhook endpoint is /api/stripe/webhook
# (event: checkout.session.completed). The publishable key is only needed if an embedded
# Stripe UI is added later; hosted Checkout does not use it.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
